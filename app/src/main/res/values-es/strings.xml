    <string name="permission_rationale_title">Por qué Amalia pide permisos</string>
    <string name="permission_mic_rationale">El micrófono se usa solo mientras hablas con Amalia. El audio nunca se guarda ni se envía sin tu acción.</string>
    <string name="permission_location_rationale">La ubicación ayuda a responder “¿qué tiempo hace?” y a encontrar lugares cercanos.</string>
    <string name="permission_contacts_rationale">Los contactos permiten decir “llama a mamá” — Amalia encuentra el número.</string>
    <string name="permission_notifications_rationale">Las notificaciones permiten a Amalia responder con la app minimizada.</string>
    <string name="permission_bluetooth_rationale">Bluetooth permite conectar tus auriculares y wearables.</string>
    <string name="permission_storage_rationale">El acceso a multimedia permite encontrar fotos, música y vídeos cuando lo pidas.</string>
