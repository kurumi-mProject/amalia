    <string name="appearance_light_title">Interface light</string>
    <string name="appearance_light_now">Now: %1$s · %2$d K</string>
    <string name="appearance_light_desc">Colour temperature adapts continuously, with no jump at the hour boundary. By day the light is cooler and aids alertness; in the evening it shifts to warm 2000–2700 K so it does not suppress melatonin.</string>
