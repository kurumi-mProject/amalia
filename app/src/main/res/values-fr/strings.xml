    <string name="permission_rationale_title">Pourquoi Amalia demande des permissions</string>
    <string name="permission_mic_rationale">Le micro n\'est utilisé que pendant que tu parles à Amalia. L\'audio n\'est jamais stocké ni envoyé sans ton action.</string>
    <string name="permission_location_rationale">La position aide à répondre « quel temps fait-il ? » et à trouver des lieux proches.</string>
    <string name="permission_contacts_rationale">Les contacts permettent « appelle maman » — Amalia trouve le numéro.</string>
    <string name="permission_notifications_rationale">Les notifications permettent à Amalia de répondre même réduite en arrière-plan.</string>
    <string name="permission_bluetooth_rationale">Le Bluetooth connecte tes écouteurs et objets connectés.</string>
    <string name="permission_storage_rationale">L\'accès aux médias permet de trouver photos, musiques et vidéos à la demande.</string>
