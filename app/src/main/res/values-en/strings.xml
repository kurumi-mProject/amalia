    <string name="permission_rationale_title">Why Amalia asks for permissions</string>
    <string name="permission_mic_rationale">The microphone is used only while you are talking to Amalia. Audio is never stored or sent anywhere without your action.</string>
    <string name="permission_location_rationale">Location helps answer “what’s the weather” and find nearby places.</string>
    <string name="permission_contacts_rationale">Contacts let you say “call mom” — Amalia finds the number for you.</string>
    <string name="permission_notifications_rationale">Notifications let Amalia answer even when the app is minimized.</string>
    <string name="permission_bluetooth_rationale">Bluetooth lets Amalia connect to your headphones and wearables.</string>
    <string name="permission_storage_rationale">Media access lets Amalia find photos, music and videos on request.</string>
