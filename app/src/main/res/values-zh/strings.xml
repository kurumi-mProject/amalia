    <!-- Appearance: circadian light -->
    <string name="appearance_light_title">Interface light</string>
    <string name="appearance_light_now">Now: %1$s · %2$d K</string>
    <string name="appearance_light_desc">Colour temperature adapts continuously, with no jump at the hour boundary. By day the light is cooler and aids alertness; in the evening it shifts to warm 2000–2700 K so it does not suppress melatonin.</string>
    <string name="appearance_melatonin">Melatonin suppression impact</string>
    <string name="appearance_melatonin_value">%1$d%%</string>
    <string name="appearance_melatonin_hint">How hard the current light pulls on your circadian system. Useful in the day, disruptive in the evening — which is why the adaptation lowers temperature in advance.</string>
    <string name="appearance_eye_title">Eye comfort</string>
    <string name="appearance_eye_contrast">Text contrast: %1$.1f:1</string>
    <string name="appearance_eye_desc">Dark mode targets 7:1 for body text instead of 4.5:1, which compensates for halation — light letters on dark bloom because of lateral inhibition in the retina. The background is never pure black and the text is never pure white.</string>
    <string name="appearance_eye_ok">Check passed</string>
    <string name="appearance_eye_astigmatism">If you have astigmatism (about one in three people), light mode reads better — set “Dark theme” to “Always light”.</string>

